    {
      "id": 11,
      "type": "timeseries",
      "title": "Conexiones a PostgreSQL por estado",
      "description": "Muchas en 'idle in transaction' retienen conexiones y bloqueos sin hacer trabajo.",
      "datasource": {
        "type": "prometheus",
        "uid": "managed-prometheus"
      },
      "gridPos": {
