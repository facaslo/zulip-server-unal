        "y": 15,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "managed-prometheus"
          },
          "expr": "sum by (state) (pg_stat_activity_count{datname=\"zulip\",state=~\"active|idle|idle in transaction\"})",
          "refId": "A",
          "legendFormat": "{{state}}",
