      "panels": [
        {
          "id": 16,
          "type": "table",
          "title": "Trazas lentas",
          "description": "Trazas de 500 ms o más, incluida la entrega por Tornado. El ID abre la traza en Explore.",
          "datasource": {
            "type": "googlecloud-trace-datasource",
            "uid": "cloud-trace"
          },
          "gridPos": {
            "x": 0,
            "y": 32,
            "w": 8,
            "h": 9
          },
          "maxDataPoints": 25,
          "targets": [
            {
              "datasource": {
                "type": "googlecloud-trace-datasource",
                "uid": "cloud-trace"
              },
              "refId": "A",
              "queryText": "MinLatency:500ms",
              "projectId": "__GCP_PROJECT__"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "noValue": "Sin trazas en este rango"
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "Trace ID"
                },
                "properties": [
                  {
                    "id": "links",
                    "value": [
                      {
                        "title": "Abrir la traza en Explore",
                        "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22cloud-trace%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22googlecloud-trace-datasource%22%2C%22uid%22%3A%22cloud-trace%22%7D%2C%22queryType%22%3A%22traceID%22%2C%22traceId%22%3A%22${__value.raw}%22%2C%22projectId%22%3A%22__GCP_PROJECT__%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-6h%22%2C%22to%22%3A%22now%22%7D%7D%7D",
